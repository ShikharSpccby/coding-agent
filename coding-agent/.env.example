# Copy this file to .env and fill in your provider's details.
# Works with any OpenAI-compatible tool-calling endpoint.

# --- Option A: Qwen via DashScope (Alibaba's native API) ---
# AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_MODEL=qwen3-coder-plus

# --- Option B: Qwen (or others) via OpenRouter ---
AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=qwen/qwen3-coder
AGENT_API_KEY=sk-REPLACE_ME

# --- Option C: local model via Ollama ---
# AGENT_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL=qwen2.5-coder:32b
# AGENT_API_KEY=ollama   # Ollama ignores this but the client requires a value

AGENT_MAX_STEPS=25
AGENT_BASH_TIMEOUT=30
AGENT_MAX_TOOL_OUTPUT=8000
AGENT_WORKSPACE=./workspace
